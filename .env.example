# Uni-Gram Database Configuration Template
# Copy this file to your local environment or export these variables in your shell.
# DO NOT commit real database passwords to version control.

# JDBC Connection URL for local MySQL Server 8.0
UNIGRAM_DB_URL=jdbc:mysql://localhost:3306/unigram_db?serverTimezone=UTC&characterEncoding=utf8mb4

# Database username
UNIGRAM_DB_USER=root

# Database user password
UNIGRAM_DB_PASSWORD=your_secure_password_here
